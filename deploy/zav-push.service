[Unit]
Description=Zav baina push sender
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zavpush
Group=zavpush
WorkingDirectory=/srv/zav-baina
EnvironmentFile=/etc/zav/push.env
ExecStart=/usr/bin/node /srv/zav-baina/scripts/push-worker.mjs
Restart=always
RestartSec=5
# The sender only needs to read its env file and node_modules.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/zav-baina
# Counts-only logging goes to the journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
