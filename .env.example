# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* values are inlined at BUILD time. The rest are read at RUNTIME.

# build-time (public, safe to expose in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_HOST=zav.localhost:3000
NEXT_PUBLIC_WORKER_HOST=ajil.zav.localhost:3000
NEXT_PUBLIC_STAFF_HOST=admin.zav.localhost:3000
# Web Push public key printed by `npm run push:keys` (public by design).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# runtime, scripts only (never used by the web app, never sent to the browser)
DATABASE_POOLER_URL=
DATABASE_URL=

# The push sender reads its own gitignored file instead of this one:
#   .env.push  (mode 600, written by `npm run push:keys` and `npm run push:role`)
#   PUSH_DATABASE_URL, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
