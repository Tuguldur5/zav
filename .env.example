# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* values are inlined at BUILD time. The rest are read at RUNTIME.

# build-time (public, safe to expose in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_HOST=zav.localhost:3000
NEXT_PUBLIC_STAFF_HOST=admin.zav.localhost:3000

# runtime, scripts only (never used by the web app, never sent to the browser)
DATABASE_POOLER_URL=
DATABASE_URL=
